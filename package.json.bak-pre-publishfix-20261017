{
  "name": "inference-quantization",
  "version": "0.1.0",
  "description": "Quantize a model checkpoint and prove it: choose a method (default AWQ+INT4), PTQ-calibrate with a leak-free split, pass an independent accuracy gate and a performance gate through real serving endpoints, auto-degrade on failure, and sign off or roll back — fully audited.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "main": "./src/index.mjs",
  "exports": {
    ".": {
      "import": "./src/index.mjs"
    },
    "./api": {
      "import": "./src/api.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "inference-quantization": "./bin/inference-quantization.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "mcp/",
    "skills/",
    "docker/",
    "cordis.patch.yml",
    "manifest.yaml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\" && npm run test:contract",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "check": "node scripts/check-manifest.mjs",
    "demo": "node scripts/e2e-demo.mjs",
    "test:contract": "node ../inference-contracts/checks/run-all.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "keywords": [
    "quantization",
    "awq",
    "llmcompressor",
    "ptq",
    "vllm",
    "dsh-plugin",
    "mcp"
  ]
}
